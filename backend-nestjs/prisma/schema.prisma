generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  JOB_SEEKER
  COMPANY_USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  CHATTING
  FINAL_HIRED
}

model User {
  id           BigInt   @id @default(autoincrement())
  role         UserRole
  email        String?  @unique
  phone        String?  @unique
  passwordHash String?  @map("password_hash")
  refreshTokenHash String? @map("refresh_token_hash")
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  jobSeekerProfile JobSeekerProfile?
  companyProfile   CompanyProfile?
  proposalStatusLogs ProposalStatusLog[]
  piiAccessLogsActor PiiAccessLog[] @relation("pii_actor")
  piiAccessLogsTarget PiiAccessLog[] @relation("pii_target")

  @@map("users")
}

model JobSeekerProfile {
  id               BigInt   @id @default(autoincrement())
  userId           BigInt   @unique @map("user_id")
  desiredSalaryMin Int      @map("desired_salary_min")
  desiredSalaryMax Int      @map("desired_salary_max")
  desiredLocations String[] @default([]) @map("desired_locations")
  jobCategory      String   @map("job_category")
  yearsExperience  Int      @map("years_experience")
  skills           String[] @default([])
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user      User       @relation(fields: [userId], references: [id])
  proposals Proposal[]

  @@map("job_seeker_profiles")
}

model CompanyProfile {
  id                     BigInt   @id @default(autoincrement())
  userId                 BigInt   @unique @map("user_id")
  companyName            String   @map("company_name")
  businessRegistrationNo String   @unique @map("business_registration_no")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  user      User       @relation(fields: [userId], references: [id])
  proposals Proposal[]

  @@map("company_profiles")
}

model Proposal {
  id               BigInt         @id @default(autoincrement())
  companyProfileId BigInt         @map("company_profile_id")
  jobSeekerProfileId BigInt       @map("job_seeker_profile_id")
  positionTitle    String         @map("position_title")
  offerSalaryMin   Int            @map("offer_salary_min")
  offerSalaryMax   Int            @map("offer_salary_max")
  workType         String?        @map("work_type")
  message          String
  status           ProposalStatus @default(PENDING)
  expiresAt        DateTime       @map("expires_at")
  acceptedAt       DateTime?      @map("accepted_at")
  rejectedAt       DateTime?      @map("rejected_at")
  finalizedAt      DateTime?      @map("finalized_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  companyProfile   CompanyProfile @relation(fields: [companyProfileId], references: [id])
  jobSeekerProfile JobSeekerProfile @relation(fields: [jobSeekerProfileId], references: [id])
  statusLogs       ProposalStatusLog[]
  piiAccessLogs    PiiAccessLog[]

  @@map("proposals")
}

model ProposalStatusLog {
  id          BigInt         @id @default(autoincrement())
  proposalId  BigInt         @map("proposal_id")
  fromStatus  ProposalStatus? @map("from_status")
  toStatus    ProposalStatus @map("to_status")
  actorUserId BigInt         @map("actor_user_id")
  reason      String?
  createdAt   DateTime       @default(now()) @map("created_at")

  proposal Proposal @relation(fields: [proposalId], references: [id])
  actor    User     @relation(fields: [actorUserId], references: [id])

  @@map("proposal_status_logs")
}

model PiiAccessLog {
  id         BigInt   @id @default(autoincrement())
  actorUserId BigInt  @map("actor_user_id")
  targetUserId BigInt @map("target_user_id")
  eventType  String   @map("event_type")
  proposalId BigInt?  @map("proposal_id")
  createdAt  DateTime @default(now()) @map("created_at")

  actor    User      @relation("pii_actor", fields: [actorUserId], references: [id])
  target   User      @relation("pii_target", fields: [targetUserId], references: [id])
  proposal Proposal? @relation(fields: [proposalId], references: [id])

  @@map("pii_access_logs")
}
